<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test host and discovery (dotnet test). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Test framework used by every test (global using Xunit below). -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- Lets dotnet test and Visual Studio run the xunit tests. -->
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Racks\Racks.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Guards\baseline.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Guards\fs-allowlist.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Guards\registry-presentation-allowlist.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
