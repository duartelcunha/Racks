<Project Sdk="Microsoft.NET.Sdk">
  <!-- Owner-only release signing tool. Not part of the app and never packaged by the installer
       (build-installer.ps1 only publishes Racks/Racks.csproj). See docs/RELEASING.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RacksSigner</RootNamespace>
    <AssemblyName>RacksSigner</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The exact manifest/signature code the app verifies with, and the app's embedded public key. -->
    <Compile Include="..\..\Racks\Util\UpdateManifest.cs" Link="Shared\UpdateManifest.cs" />
    <Compile Include="..\..\Racks\Util\UpdateTrust.cs" Link="Shared\UpdateTrust.cs" />
  </ItemGroup>
</Project>
