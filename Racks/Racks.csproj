<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <RootNamespace>Racks</RootNamespace>
    <AssemblyName>Racks</AssemblyName>
    <Product>Racks</Product>
    <AssemblyTitle>Racks</AssemblyTitle>
    <Description>Racks — fast, lightweight desktop organization for Windows.</Description>
    <Version>1.4.0</Version>
    <PackageIcon>ico.png</PackageIcon>
    <ApplicationIcon>Icon\ico.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Produce a single standalone EXE -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="ico.png" />
    <None Remove="Icon\ico.png" />
    <None Remove="Icon\tray.png" />
    <None Remove="Icon\tray_16.png" />
    <None Remove="Icon\tray_20.png" />
    <None Remove="Icon\tray_24.png" />
    <None Remove="Icon\tray_32.png" />
    <None Remove="Shaders\GrayscaleEffect.ps" />
  </ItemGroup>
  <!-- COMReference items for Shell32 + IWshRuntimeLibrary were removed because they
       require the full MSBuild from Visual Studio (`dotnet build` errors with MSB4803).
       Shell32 was unused; IWshRuntimeLibrary was only used for .lnk creation, which is
       now handled by Util/ShellLinkHelper.cs (hand-rolled ComImport IShellLink). -->
  <ItemGroup>
    <!-- Low-level global mouse hook for double-click-to-hide (Infrastructure/Shell/GlobalMouseHook.cs, UseCases/DoubleClickHide). -->
    <PackageReference Include="H.Hooks" Version="1.7.0" />
    <!-- Shell folder/file pickers and shell objects (RackWindow.*.cs, dialogs). -->
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <!-- Local, offline file categorisation for Magic Organize (Core/AutoOrganizer.cs). Pulls Newtonsoft.Json transitively. -->
    <PackageReference Include="Microsoft.ML" Version="5.0.1" />
    <!-- Toast notifications and toast activation (Infrastructure/Startup, Infrastructure/Update/ToastUpdateNotifier.cs, Views/HotkeyConflictToast.cs). -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Virtual desktop queries and change events (Core/Instance.cs, RackWindow.*.cs, RackSettingsDialog). Pulls Microsoft.CodeAnalysis transitively. -->
    <PackageReference Include="Slions.VirtualDesktop" Version="6.9.2" />
    <!-- SVG rendering for icons, behind the sanitiser Util/SafeSvg.cs. Pulls ExCSS transitively. -->
    <PackageReference Include="Svg" Version="3.4.8" />
    <!-- WPF-UI tray icon (NotifyIcon in MainWindow.xaml) and Fluent controls/theme used across the windows. -->
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Icon\Ico.ico" />
    <Content Include="Icon\WorkspaceFolder.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="ico.png" />
    <Resource Include="Icon\ico.png" />
    <Resource Include="Icon\tray.png" />
    <Resource Include="Icon\tray_16.png" />
    <Resource Include="Icon\tray_20.png" />
    <Resource Include="Icon\tray_24.png" />
    <Resource Include="Icon\tray_32.png" />
    <Resource Include="Shaders\GrayscaleEffect.ps" />
  </ItemGroup>
  <!-- Strongly typed Lang class.
       Properties\Lang.Designer.cs is regenerated from Lang.resx on every `dotnet build` (no Visual
       Studio needed): add a key to Lang.resx, build, and Lang.Key exists. It runs before the WPF
       markup compiler because XAML uses {x:Static prop:Lang.Key}, and WPF's temporary markup
       assembly is compiled before MSBuild's own resource step would generate the class.
       The file stays in git so the class is readable on GitHub; commit it with the resx change. -->
  <Target Name="GenerateLangClass"
          BeforeTargets="MarkupCompilePass1;CoreCompile"
          Inputs="Properties\Lang.resx"
          Outputs="Properties\Lang.Designer.cs">
    <MakeDir Directories="$(IntermediateOutputPath)LangGen" />
    <GenerateResource Sources="Properties\Lang.resx"
                      OutputResources="$(IntermediateOutputPath)LangGen\Lang.resources"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="Racks.Properties"
                      StronglyTypedClassName="Lang"
                      StronglyTypedManifestPrefix="Racks.Properties"
                      StronglyTypedFileName="Properties\Lang.Designer.cs"
                      PublicClass="true"
                      ExecuteAsTool="false" />
    <ItemGroup>
      <Compile Include="Properties\Lang.Designer.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Racks.Tests" />
  </ItemGroup>
</Project>